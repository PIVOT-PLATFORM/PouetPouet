{
  "name": "@pouetpouet/api",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "npx prisma migrate deploy && node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:mutation": "stryker run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:procurement": "tsx --env-file=.env scripts/seed-procurement.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@google-cloud/storage": "^8.4.0",
    "@pouetpouet/shared": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.8.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
