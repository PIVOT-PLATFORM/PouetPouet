{
  "name": "pouetpouet",
  "version": "0.32.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "security:audit": "npm audit --audit-level=critical --omit=dev",
    "docs:features": "node docs/generate-features.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.9.5",
    "prisma": "7.10.1",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "postcss": "^8.5.31"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "pdf-lib": "^1.17.1"
  }
}
